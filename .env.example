# Preferred production path: a server-side Kunpo Gateway without a local API key.
KUNPO_GATEWAY_BASE_URL=http://127.0.0.1:9020/v1

# Embedded assistant is opt-in and read once when the desktop app or Web server starts.
# GAME_UI_ASSISTANT_ENABLED=true

# Online service settings. Keep real values only in the server's protected env file.
# HOST=0.0.0.0
# PORT=9030
# PUBLIC_URL=http://10.8.0.176:9030
# DESIGN_COPILOT_DATA_ROOT=/var/lib/game-ui-design-copilot-online
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=replace-on-server-only
# FEISHU_REDIRECT_URI=http://10.8.0.176:9030/auth/feishu/callback
# SESSION_SECRET=generate-a-long-random-server-only-value
# SESSION_COOKIE_NAME=design_copilot_session
# OAUTH_COOKIE_NAME=design_copilot_oauth
# DESIGN_COPILOT_RELEASE_ID=development
# DESIGN_COPILOT_VERSION_LABEL=单版本

# Version router settings. Only loopback upstream origins are accepted.
# ROUTER_HOST=0.0.0.0
# ROUTER_PORT=9030
# ROUTER_PUBLIC_URL=http://10.8.0.176:9030
# ROUTER_DEFAULT_VERSION=classic
# ROUTER_CLASSIC_UPSTREAM=http://127.0.0.1:9031
# ROUTER_CURRENT_UPSTREAM=http://127.0.0.1:9032
# ROUTER_VERSION_COOKIE_NAME=design_copilot_version
# ROUTER_CLASSIC_SESSION_COOKIE_NAME=design_copilot_session
# ROUTER_MAX_HTML_BYTES=1048576
# ROUTER_UPSTREAM_TIMEOUT_MS=1320000
# ROUTER_HEALTH_TIMEOUT_MS=2000

# Local-only direct API fallback. Never commit a real key.
# KUNPO_API_BASE_URL=https://example.com/v1
# KUNPO_API_KEY=replace-me

# Optional: reuse a separately managed local env file.
# DESIGN_COPILOT_ENV_FILE=/absolute/path/to/.env
