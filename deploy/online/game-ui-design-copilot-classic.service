[Unit]
Description=Game UI Design Copilot Classic
After=network-online.target kunpo-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=game-ui-design-copilot
Group=game-ui-design-copilot
WorkingDirectory=@@CLASSIC_RELEASE_DIR@@
EnvironmentFile=/etc/game-ui-design-copilot-online/game-ui-design-copilot-online.env
ExecStart=/usr/bin/env HOST=127.0.0.1 PORT=9031 DESIGN_COPILOT_RELEASE_ID=20260812-113232-f9dc444 DESIGN_COPILOT_VERSION_LABEL=经典版 /opt/game-ui-design-copilot-online/runtime/node/bin/node @@CLASSIC_RELEASE_DIR@@/server/webServer.cjs
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/game-ui-design-copilot-online /var/log/game-ui-design-copilot-online
InaccessiblePaths=-/var/lib/game-ui-design-copilot-online/version-data

[Install]
WantedBy=multi-user.target
