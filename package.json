{
  "name": "game-ui-design-copilot",
  "version": "0.2.0",
  "private": true,
  "description": "Artifact-driven AI workflow for game UI designers.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron .\"",
    "quick-start": "node scripts/start-copilot.cjs",
    "quick-start:check": "node scripts/start-copilot.cjs --check",
    "dev:renderer": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "lint": "tsc --noEmit",
    "test": "node --test electron/services/*.test.cjs server/*.test.cjs",
    "start:web": "node server/webServer.cjs",
    "test:kunpo": "node scripts/smoke-kunpo.cjs",
    "test:kunpo-image": "node scripts/smoke-kunpo-image.cjs"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wait-on": "9.1.0"
  }
}
