{
  "name": "game-ui-design-copilot",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "description": "Artifact-driven AI workflow for game UI designers.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron .\"",
    "quick-start": "node scripts/start-copilot.cjs",
    "quick-start:check": "node scripts/start-copilot.cjs --check",
    "dev:renderer": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "lint": "tsc --noEmit",
    "test": "node --test electron/services/*.test.cjs server/*.test.cjs scripts/*.test.cjs",
    "test:ui-unit": "vitest run",
    "test:fixture-e2e": "node --test electron/services/goldenFixtures.test.cjs",
    "test:ui-e2e": "playwright test",
    "test:docs": "node scripts/check-docs.cjs && node scripts/check-error-docs.cjs && node scripts/check-doc-commands.cjs && node scripts/check-project-tree.cjs",
    "start:web": "node server/webServer.cjs",
    "test:kunpo": "node scripts/smoke-kunpo.cjs",
    "test:kunpo-image": "node scripts/smoke-kunpo-image.cjs",
    "golden:prepare": "node scripts/prepare-real-golden-assets.cjs",
    "golden:run:real": "node scripts/run-real-golden-e2e.cjs"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "9.1.0"
  }
}
